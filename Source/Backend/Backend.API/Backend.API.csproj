<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace-Wurzel bleibt "Backend" – projektübergreifend konsistente Namespaces -->
    <RootNamespace>Backend</RootNamespace>
    <!-- Ausgabe-Binary muss "Finanzen.API" heißen: die systemd-Unit auf dem vServer
         (ExecStart=/opt/finanzen/app/Finanzen.API) erwartet exakt diesen Namen. -->
    <AssemblyName>Finanzen.API</AssemblyName>
    <UserSecretsId>c8b4a2d1-3e5f-4a7b-9c8d-1e2f3a4b5c6d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!--
      Explizites Version-Override: Microsoft.AspNetCore.OpenApi zieht transitiv EF Core 10.0.4
      (aus dem ASP.NET-App-Framework) herein, während Backend.DataAccess EF Core 10.0.9
      (via Npgsql) verwendet. Dieser direkte Verweis pinnt Backend.API auf dieselbe Version
      und verhindert den CS1705-Versionskonflikt beim Linken.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Explizites Version-Override: Microsoft.AspNetCore.OpenApi 10.0.8 und Swashbuckle.AspNetCore.SwaggerUI
      ziehen transitiv Microsoft.OpenApi 2.0.0 herein, das eine bekannte Sicherheitslücke
      hat (NU1903 / GHSA-v5pm-xwqc-g5wc). Dieser direkte Verweis pinnt auf eine gepatchte Version.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <!-- Nur die Swagger-UI (Dev). Das OpenAPI-Dokument selbst liefert Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend.DataAccess\Backend.DataAccess.csproj" />
  </ItemGroup>

</Project>
